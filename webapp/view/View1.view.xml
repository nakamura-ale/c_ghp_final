<mvc:View
    controllerName="cghpfinal.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    xmlns:fb="sap.ui.comp.filterbar"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <!-- Filter Bar -->
            <fb:FilterBar
                id="filterBar1"
                reset="onFilterReset"
                search="onSearch"
                showGoOnFB="true"
            >
                <fb:filterGroupItems>
                    <fb:FilterGroupItem
                        name="InterfaceType"
                        label="Interface Type"
                        groupName="$INTERNAL$"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <Input value="{filter>/ZTPINT}" />
                        </fb:control>
                    </fb:FilterGroupItem>

                    <fb:FilterGroupItem
                        name="Batch"
                        label="{i18n>ZBATCH}"
                        groupName="$INTERNAL$"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <Input value="{filter>/ZBATCH}" />
                        </fb:control>
                    </fb:FilterGroupItem>

                    <fb:FilterGroupItem
                        name="Status"
                        label="{i18n>STATUS}"
                        groupName="$INTERNAL$"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <Input value="{filter>/STATUS}" />
                        </fb:control>
                    </fb:FilterGroupItem>

                    <fb:FilterGroupItem
                        name="ZDTRECEBIMENTO_FROM"
                        label="{i18n>RECEPIPTDATEFROM}"
                        groupName="$INTERNAL$"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <DatePicker
                                width="100%"
                                displayFormat="yyyy.MM.dd"
                                valueFormat="yyyy-MM-dd"
                                value="{filter>/ZDTRECEBIMENTO_FROM}"
                            />
                        </fb:control>
                    </fb:FilterGroupItem>

                    <fb:FilterGroupItem
                        name="ZDTRECEBIMENTO_TO"
                        label="{i18n>RECEPIPTDATETO}"
                        groupName="$INTERNAL$"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <DatePicker
                                width="100%"
                                displayFormat="yyyy.MM.dd"
                                valueFormat="yyyy-MM-dd"
                                value="{filter>/ZDTRECEBIMENTO_TO}"
                            />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

            <FlexBox
                alignItems="Center"
                justifyContent="End"
            >
                <Button
                    text="Reprocessamento"
                    class="sapUiTinyMarginEnd"
                    press="onReprocess"
                    icon="sap-icon://refresh"
                />
            </FlexBox>

            <!-- Tabela -->
            <table:Table
                id="tblData"
                rows="{view>/data}"
                visibleRowCount="20"
                visibleRowCountMode="Fixed"
                selectionMode="MultiToggle"
                enableColumnReordering="true"
                enableColumnFreeze="true"
                enableSelectAll="false"
                class="sapUiSmallMarginTop centerTable"
            >
                <table:Column
                    sortProperty="ZTPINT"
                    filterProperty="ZTPINT"
                    width="80px"
                >
                    <Label text="Interface Type" />
                    <table:template>
                        <HBox
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                        >
                            <Text text="{view>ZTPINT}" />

                            <core:Icon
                                id="_IDGenIcon"
                                src="sap-icon://error"
                                color="Negative"
                                visible="{= ${view>ZSTATUSDOC} !== 'OK' }"
                                tooltip="ZTPINT maior que 10!"
                            />
                        </HBox>
                    </table:template>
                </table:Column>

                <table:Column
                    sortProperty="ZBATCH"
                    sortOrder="Ascending"
                >
                    <Label text="Batch" />
                    <table:template>
                        <Text text="{view>ZBATCH}" />
                    </table:template>
                </table:Column>
                <table:Column
                    sortProperty="GM_CODE"
                    sortOrder="Ascending"
                    width="50px"
                >
                    <Label text="GM_CODE" />
                    <table:template>
                        <Text text="{view>GM_CODE}" />
                    </table:template>
                </table:Column>
                <table:Column
                    sortProperty="ZDTRECEBIMENTO"
                    sortOrder="Ascending"
                    width="100px"
                >
                    <Label text="Receipt Date" />
                    <table:template>
                        <Text
                            text="{path: 'view>ZDTRECEBIMENTO', formatter: '.formatter.formatDate'}"
                        />
                    </table:template>
                </table:Column>
                <table:Column
                    sortProperty="PSTNG_DATE"
                    sortOrder="Ascending"
                    width="100px"
                >
                    <Label text="PSTNG_DATE" />
                    <table:template>
                        <Text
                            text="{path: 'view>PSTNG_DATE', formatter: '.formatter.formatDate'}"
                        />
                    </table:template>
                </table:Column>
                <table:Column
                    sortProperty="HEADER_TXT"
                    sortOrder="Ascending"
                    width="100px"
                >
                    <Label text="HEADER_TXT" />
                    <table:template>
                        <Text text="{view>HEADER_TXT}" />
                    </table:template>
                </table:Column>
                <table:Column
                    sortProperty="REF_DOC_NO"
                    sortOrder="Ascending"
                    width="100px"
                >
                    <Label text="REF_DOC_NO" />
                    <table:template>
                        <Text text="{view>REF_DOC_NO}" />
                    </table:template>
                </table:Column>
                <table:Column
                    sortProperty="BATCH"
                    sortOrder="Ascending"
                    width="110px"
                >
                    <Label text="BATCH" />
                    <table:template>
                        <Text text="{view>BATCH}" />
                    </table:template>
                </table:Column>
                <table:Column
                    sortProperty="ZSTATUSDOC"
                    sortOrder="Ascending"
                    width="50px"
                >
                    <Label text="Status" />
                    <table:template>
                        <Text text="{view>ZSTATUSDOC}" />
                    </table:template>
                </table:Column>
                <table:Column
                    sortProperty="ZITMNUM"
                    sortOrder="Ascending"
                    width="70px"
                >
                    <Label text="Itm" />
                    <table:template>
                        <Text text="{view>ZITMNUM}" />
                    </table:template>
                </table:Column>

                <table:Column
                    sortProperty="MATERIAL_CODE"
                    sortOrder="Ascending"
                    width="180px"
                >
                    <Label text="Material Code" />
                    <table:template>
                        <Text text="{view>MATERIAL_CODE}" />
                    </table:template>
                </table:Column>
                <table:Column>
                    <Label text="Quantity" />
                    <table:template>
                        <Text text="{view>QUANTITY}" />
                    </table:template>
                </table:Column>
                <table:Column>
                    <Label text="Unit Of Measure" />
                    <table:template>
                        <Text text="{view>UNIDADE}" />
                    </table:template>
                </table:Column>
                <table:Column>
                    <Label text="Plant" />
                    <table:template>
                        <Text text="{view>PLANT}" />
                    </table:template>
                </table:Column>
                <table:Column>
                    <Label text="Time of Receipt" />
                    <table:template>
                        <Text
                            text="{path: 'view>TIME', formatter: '.formatter.formatTime'}"
                        />
                    </table:template>
                </table:Column>
                <table:Column width="100px">
                    <Label text="Account" />
                    <table:template>
                        <Text text="{view>GL_ACCOUNT}" />
                    </table:template>
                </table:Column>
                <table:Column width="100px">
                    <Label text="NF-e Reference" />
                    <table:template>
                        <Text text="{view>NFE_REFERENCE}" />
                    </table:template>
                </table:Column>
                <table:Column>
                    <Label text="Moviment Type" />
                    <table:template>
                        <Text text="{view>MOVIMENT}" />
                    </table:template>
                </table:Column>
                <table:Column>
                    <Label text="Deposit" />
                    <table:template>
                        <Text text="{view>DEPOSIT}" />
                    </table:template>
                </table:Column>
                <table:Column>
                    <Label text="Split" />
                    <table:template>
                        <Text text="{view>SPLIT}" />
                    </table:template>
                </table:Column>
                <table:Column>
                    <Label text="Error Message" />
                    <table:template>
                        <Text text="{view>ZMSG}" />
                    </table:template>
                </table:Column>
            </table:Table>
        </content>
    </Page>
</mvc:View>
